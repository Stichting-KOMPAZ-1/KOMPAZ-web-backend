APP_NAME=KOMPAZ
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl
APP_FAKER_LOCALE=nl_NL

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The dev database, from docker-compose.yml. Published on 3307 so it cannot collide with a MySQL
# already running locally.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=kompaz
DB_USERNAME=kompaz
DB_PASSWORD=kompaz

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="geen-antwoord@kompaz.test"
MAIL_FROM_NAME="${APP_NAME}"

# Where the browser-facing application lives, and the path on it that redeems the secret from a
# sign-in link. This is the frontend, never this API: a person who clicks a link should land on a
# page, not on a JSON document.
FRONTEND_URL=http://localhost:5173
FRONTEND_SIGN_IN_PATH=/inloggen

# Signs the access tokens. Empty on purpose: a deployment that forgets it fails at startup rather
# than running on a value that is in the repository. Generate one with
# `php artisan kompaz:generate-signing-key`.
AUTH_SIGNING_KEY=
AUTH_ISSUER=kompaz
AUTH_AUDIENCE=kompaz
AUTH_ACCESS_TOKEN_LIFETIME_MINUTES=60
AUTH_MAGIC_LINK_LIFETIME_MINUTES=30
AUTH_INVITATION_LIFETIME_DAYS=7
# The idle window, restarted by every refresh, and the ceiling it can never pass.
AUTH_REFRESH_SLIDING_LIFETIME_DAYS=14
AUTH_REFRESH_ABSOLUTE_LIFETIME_DAYS=90

# Nova validates this against the domain the panel is served from, so it is a runtime setting and
# not only a Composer credential. The panel refuses to render without it.
NOVA_LICENSE_KEY=

# Where uploaded logos go. `local` is for a developer machine only: fortrabbit's filesystem is
# ephemeral, so a deployment left pointed at it loses every logo on the next deploy.
LOGO_DISK=local

# fortrabbit Object Storage, injected by the platform once it is attached to the app.
OBJECT_STORAGE_KEY=
OBJECT_STORAGE_SECRET=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_SERVER=

# Per client address, so a value tuned for one person locks out an office.
RATE_LIMIT_MAGIC_LINK_ATTEMPTS=5
RATE_LIMIT_MAGIC_LINK_WINDOW_SECONDS=300
RATE_LIMIT_SIGN_IN_ATTEMPTS=30
RATE_LIMIT_SIGN_IN_WINDOW_SECONDS=300
RATE_LIMIT_API_ATTEMPTS=100

# Which proxies to believe about the client's address and scheme. Empty trusts none; `*` is only
# safe where the application is unreachable except through the proxy, which is true on fortrabbit.
TRUSTED_PROXIES=

# The organization that runs the platform, and its first administrator. Seeded as Invited, so they
# sign in with an emailed link like everybody else. Without one, nobody can invite anybody.
SEED_PLATFORM_ORGANIZATION="KOMPAZ"
SEED_PLATFORM_ADMINISTRATOR_EMAIL=super@igne.nl
SEED_PLATFORM_ADMINISTRATOR_NAME="Platformbeheerder"
