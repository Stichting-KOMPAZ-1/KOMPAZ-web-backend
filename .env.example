APP_NAME=KOMPAZ
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl
APP_FAKER_LOCALE=nl_NL

# Where the browser-facing application lives. Sign-in links point at it.
FRONTEND_URL=http://localhost:5173
FRONTEND_SIGN_IN_PATH=/inloggen

LOG_CHANNEL=stack
LOG_LEVEL=debug

# The dev database, from docker-compose.yml.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=kompaz
DB_USERNAME=kompaz
DB_PASSWORD=kompaz

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Authentication. The signing key is empty on purpose: a deployment that forgets it fails at
# startup rather than running on a value that is in the repository. Generate one with
# `php artisan kompaz:generate-signing-key`.
AUTH_SIGNING_KEY=
AUTH_ISSUER=kompaz
AUTH_AUDIENCE=kompaz
AUTH_ACCESS_TOKEN_LIFETIME_MINUTES=60
AUTH_MAGIC_LINK_LIFETIME_MINUTES=30
AUTH_INVITATION_LIFETIME_DAYS=7
AUTH_REFRESH_SLIDING_LIFETIME_DAYS=14
AUTH_REFRESH_ABSOLUTE_LIFETIME_DAYS=90

# Mail. `log` writes sign-in links into the log, which is a credential leak anywhere but a
# developer machine — the application refuses to boot with it outside local development.
MAIL_MAILER=log
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="geen-antwoord@kompaz.nl"
MAIL_FROM_NAME="${APP_NAME}"

# Uploaded files. `local` is for a developer machine only: fortrabbit's filesystem is ephemeral, so
# a deployment left pointed at it loses every logo on the next deploy.
FILESYSTEM_DISK=local
LOGO_DISK=local

# fortrabbit Object Storage. Injected by the platform on a fortrabbit app.
OBJECT_STORAGE_KEY=
OBJECT_STORAGE_SECRET=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_SERVER=

# Rate limiting, per client address.
RATE_LIMIT_MAGIC_LINK_ATTEMPTS=5
RATE_LIMIT_MAGIC_LINK_WINDOW_SECONDS=300
RATE_LIMIT_SIGN_IN_ATTEMPTS=30
RATE_LIMIT_SIGN_IN_WINDOW_SECONDS=300
RATE_LIMIT_API_ATTEMPTS=100

# Which proxies to believe about the client's address and scheme. Empty trusts none; `*` is only
# safe where the application is unreachable except through the proxy.
TRUSTED_PROXIES=

# The organization that runs the platform, and its first administrator.
SEED_PLATFORM_ORGANIZATION="KOMPAZ"
SEED_PLATFORM_ADMINISTRATOR_EMAIL=
SEED_PLATFORM_ADMINISTRATOR_NAME="Platformbeheerder"
