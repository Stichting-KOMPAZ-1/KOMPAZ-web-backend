APP_NAME=KOMPAZ
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl
APP_FAKER_LOCALE=nl_NL
APP_DISPLAY_TIMEZONE=Europe/Amsterdam

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The dev database, from docker-compose.yml. Published on 3307 so it cannot collide with a MySQL
# already running locally.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=kompaz
DB_USERNAME=kompaz
DB_PASSWORD=kompaz

# Sessions live in the database because a session is a credential here and is revoked by deleting
# its row, the same way a token is. The application refuses to start on any other driver.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave this null while nginx serves the frontend and the API under one host. Give it the shared
# parent domain (".kompaz.nl") when it serves them under two, or the browser will not send the
# cookie back to the API. Two unrelated domains cannot share a session cookie at all.
SESSION_DOMAIN=null
# Null lets the framework decide from the scheme it sees, which behind a TLS-terminating nginx is
# only the real one once TRUSTED_PROXIES is set. Set it to true to decide it here instead.
SESSION_SECURE_COOKIE=null

BROADCAST_CONNECTION=log

# Where uploaded logos go. The `local` disk writes to storage/app/private, which is not reachable
# over HTTP — a logo is read back through the API, which checks the caller's token first.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="geen-antwoord@kompaz.test"
MAIL_FROM_NAME="${APP_NAME}"

# Where the public browser-facing application lives, and the path on it that redeems a magic link.
# Invitations and Nova sign-in links use APP_URL instead: an invitation is accepted by this
# application, which then sends the recipient on to a sign-in screen.
FRONTEND_URL=http://localhost:5173
FRONTEND_SIGN_IN_PATH=/inloggen

# How long the two kinds of emailed link stay redeemable.
AUTH_MAGIC_LINK_LIFETIME_MINUTES=30
AUTH_INVITATION_LIFETIME_DAYS=7

# How long an API token lasts, in minutes. 43200 is 30 days.
SANCTUM_EXPIRATION=43200

# The hosts whose requests are given a session cookie instead of being read for a bearer token.
# Defaults to the host and port of FRONTEND_URL, which is the one browser application entitled to
# one; every other caller keeps using an Authorization header. Comma-separated, host[:port], no
# scheme. Naming a host here trusts it with a signed-in visitor's session.
#
# Behind nginx this is the host the *browser* asked for, not the one nginx proxies to. Sanctum
# matches it against the request's Referer, falling back to Origin — both set by the browser and
# passed through untouched, so nothing here depends on the proxy. It does mean a frontend that
# sends neither (referrerPolicy "no-referrer" on a same-origin GET) silently gets no session.
SANCTUM_STATEFUL_DOMAINS=

# Nova validates this against the domain the panel is served from, so it is a runtime setting and
# not only a Composer credential. The panel refuses to render without it.
NOVA_LICENSE_KEY=

# Per client address, so a value tuned for one person locks out an office.
RATE_LIMIT_MAGIC_LINK_ATTEMPTS=5
RATE_LIMIT_MAGIC_LINK_WINDOW_SECONDS=300
RATE_LIMIT_SIGN_IN_ATTEMPTS=30
RATE_LIMIT_SIGN_IN_WINDOW_SECONDS=300
RATE_LIMIT_API_ATTEMPTS=100

# Whether /docs/api is readable by anyone. Defaults to off outside local development; a signed-in
# platform administrator can always read it.
API_DOCS_PUBLIC=true

# Which proxies to believe about the client's address and scheme. Empty trusts none; `*` is only
# safe where the application is unreachable except through the proxy, which is true on fortrabbit.
#
# With an nginx in front, leaving this empty does more than muddle the rate-limit partition: the
# application sees plain HTTP, so the session cookie is issued without Secure and a browser drops
# it on the way back. Whatever terminates TLS has to be named here.
TRUSTED_PROXIES=

# The organization that runs the platform, and its first administrator. Seeded as Invited, so they
# sign in with an emailed link like everybody else. Without one, nobody can invite anybody.
SEED_PLATFORM_ORGANIZATION="KOMPAZ"
SEED_PLATFORM_ADMINISTRATOR_EMAIL=super@igne.nl
SEED_PLATFORM_ADMINISTRATOR_NAME="Platformbeheerder"
